{
  "expo": {
    "name": "ZipNab",
    "slug": "zipnab",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "zipnab",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#16a34a" },
    "ios": {
      "bundleIdentifier": "app.zipnab.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ZipNab matches you with nearby stores and shows live Runner location.",
        "NSCameraUsageDescription": "Runners photograph receipts and deliveries as proof."
      }
    },
    "android": {
      "package": "app.zipnab.mobile",
      "permissions": ["ACCESS_FINE_LOCATION", "CAMERA"]
    },
    "plugins": ["expo-location", "expo-image-picker"]
  }
}
