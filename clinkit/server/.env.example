# Clinkit server — copy to .env. Everything optional in mock mode (the default).
PORT=4000
NODE_ENV=development
PROVIDERS_MOCK=1
STRIPE_MOCK=1
AVALARA_MOCK=1
JWT_SECRET=change-me-64-random-chars
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://clinkit:clinkit@localhost:5432/clinkit
REDIS_URL=redis://localhost:6379

# Real integrations (set PROVIDERS_MOCK=0 once populated)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
WALMART_PRIVATE_KEY=
INSTACART_API_KEY=
BRISKLY_API_KEY=
SERPAPI_KEY=
GOOGLE_MAPS_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AVALARA_ACCOUNT_ID=
AVALARA_LICENSE_KEY=
AVALARA_COMPANY_CODE=ZIPNAB

# Ops
ADMIN_TOKEN=
LOG_LEVEL=info

# AI support agent (auto-live: key present => Claude-powered; absent => policy router)
ANTHROPIC_API_KEY=
SUPPORT_MODEL=claude-opus-5

# Order economics (founder levers)
MIN_ORDER_CENTS=2000
BUNDLE_REBATE_CENTS=200
